<svg class="background">
  <rect class="bg" x="0" y="0" width="100%" height="100%" />

  <!-- 1. Shortcuts -->
  <g id="screen-shortcuts" display="none">
    <text class="title" x="30" y="55">Shortcuts</text>

    <g id="row-0"><circle class="dot" id="dot-0" cx="50" cy="105" r="10" /><text class="row-label" id="row-0-label" x="75" y="115"></text><rect class="hit" x="0" y="80" width="336" height="55" pointer-events="visible" /></g>
    <g id="row-1"><circle class="dot" id="dot-1" cx="50" cy="165" r="10" /><text class="row-label" id="row-1-label" x="75" y="175"></text><rect class="hit" x="0" y="140" width="336" height="55" pointer-events="visible" /></g>
    <g id="row-2"><circle class="dot" id="dot-2" cx="50" cy="225" r="10" /><text class="row-label" id="row-2-label" x="75" y="235"></text><rect class="hit" x="0" y="200" width="336" height="55" pointer-events="visible" /></g>
    <g id="row-3"><circle class="dot" id="dot-3" cx="50" cy="285" r="10" /><text class="row-label" id="row-3-label" x="75" y="295"></text><rect class="hit" x="0" y="260" width="336" height="55" pointer-events="visible" /></g>
  </g>

  <!-- 2. Activity -->
  <g id="screen-activity" display="none">
    <text class="title center" id="activityTitle" x="168" y="110"></text>
    <circle class="btn-blue" cx="100" cy="220" r="42" />
    <text class="btn-label center" x="100" y="226">Back</text>
    <rect id="btn-back" class="hit" x="50" y="170" width="100" height="100" pointer-events="visible" />
    <circle class="btn-orange" cx="236" cy="220" r="42" />
    <text class="btn-label center" x="236" y="226">Start</text>
    <rect id="btn-start" class="hit" x="186" y="170" width="100" height="100" pointer-events="visible" />
  </g>

  <!-- 3. Running -->
  <g id="screen-running" display="none">
    <text class="big" id="elapsedRun" x="30" y="90">0:00</text>
    <text class="stat" id="calRun" x="30" y="170">0 cals</text>
    <text class="stat" id="hrRun" x="30" y="230">-- bpm</text>
    <rect class="pause-bar" x="262" y="262" width="12" height="40" />
    <rect class="pause-bar" x="286" y="262" width="12" height="40" />
    <rect id="btn-pause" class="hit" x="226" y="226" width="110" height="110" pointer-events="visible" />
  </g>

  <!-- 4. Paused -->
  <g id="screen-paused" display="none">
    <text class="btn-text right" x="310" y="55">End</text>
    <rect id="btn-end" class="hit" x="216" y="0" width="120" height="90" pointer-events="visible" />
    <text class="big center" id="elapsedPause" x="168" y="180">0:00</text>
    <text class="stat" x="30" y="300">paused</text>
    <text class="btn-text right" x="310" y="300">Resume</text>
    <rect id="btn-resume" class="hit" x="196" y="246" width="140" height="90" pointer-events="visible" />
  </g>

  <!-- 5. Summary -->
  <g id="screen-summary" display="none">
    <text class="title" id="summaryTitle" x="30" y="55">Nice work!</text>
    <text class="stat" id="sumTime" x="30" y="125">0:00</text>
    <text class="stat" id="sumAvg" x="30" y="175">-- bpm avg</text>
    <text class="stat" id="sumMax" x="30" y="225">-- bpm max</text>
    <text class="stat" id="sumCal" x="30" y="275">0 cals</text>
    <rect id="btn-done" class="hit" x="0" y="0" width="336" height="336" pointer-events="visible" />
  </g>
</svg>
